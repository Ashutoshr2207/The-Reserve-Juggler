asf = np.array([
    bank.get_business_line_funding(k)["long_term"] * .95
    + bank.get_business_line_funding(k)["short_term"] * .05
    for k in lines
])
rsf = np.array([
    liquidity.calculate_rsf(
        rsf_asset_profile_for_assets(bank.business_line_assets[k])
    )["total_rsf"] for k in lines
])
strategies = [
    ("conservative", .15, .055, 1.25, 1.15, .70, 1.15),
    ("moderate", .13, .040, 1.10, 1.05, .60, 1.30),
    ("aggressive", .105, .032, 1.02, 1.01, .50, 1.60),
]
for name, ct, lt, lc, ns, lo, hi in strategies:
    A = np.array([
        ct*rwa, lt*assets*1.12, lc*outflow-hqla, ns*rsf-asf, cap
    ])
    b = np.array([40000, 44000, 0, 0, 40000])
    result = linprog(
        -rate*cap, A_ub=A, b_ub=b,
        bounds=[(lo, hi)] * len(lines), method="highs"
    )
    s = result.x
    print(name, result.success, s, cap@s, -result.fun/(cap@s),
          40000/(rwa@s), 44000/(assets@s*1.12),
          (hqla@s)/(outflow@s), (asf@s)/(rsf@s),
          max(0, np.max(A@s-b)))
