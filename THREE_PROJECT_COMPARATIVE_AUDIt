~~~python
import numpy as np
from liquidity_forecasting.data import generate_sample_cashflows
from liquidity_forecasting.evaluation import (
    rolling_backtest_currency, seasonal_naive_forecast
)

data = generate_sample_cashflows()  # seed 42; all default currencies
for currency in data.columns:
    results = rolling_backtest_currency(
        data, currency,
        lambda d, c, periods: seasonal_naive_forecast(d[c], periods),
        horizon=7, folds=3, season_length=7
    )
    # The injected callback is intentionally naive too. Report only the
    # independently implemented comparator rows, never call this SARIMAX.
    for _, result in results[results.Model == "Seasonal Naive"].iterrows():
        fold = int(result.Fold)
        n = len(data) - (4 - fold) * 7
        actual = data[currency].iloc[n:n+7].to_numpy()
        predicted = np.resize(data[currency].iloc[n-7:n].to_numpy(), 7)
        mae = np.abs(actual - predicted).mean()
        scale = np.abs(
            data[currency].iloc[7:n].to_numpy()
            - data[currency].iloc[:n-7].to_numpy()
        ).mean()
        assert np.isclose(mae, result.MAE)
        assert np.isclose(mae / scale, result.MASE)
        print(currency, fold, n, result.to_dict())
