{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reserve-juggler:forecast-adapter:1.0",
  "title": "Internal forecast adapter messages",
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Response"
    }
  ],
  "$defs": {
    "HistoryRow": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "description": "Naive synthetic clock, not UTC metadata."
        },
        "deposits_cents": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "withdrawals_cents": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "timestamp",
        "deposits_cents",
        "withdrawals_cents"
      ],
      "additionalProperties": false
    },
    "Prediction": {
      "type": "object",
      "properties": {
        "horizon_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "deposits_cents": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "withdrawals_cents": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "horizon_hours",
        "deposits_cents",
        "withdrawals_cents"
      ],
      "additionalProperties": false
    },
    "PathQuantile": {
      "type": "object",
      "properties": {
        "horizon_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "quantile": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "max_cumulative_deficit_cents": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "horizon_hours",
        "quantile",
        "max_cumulative_deficit_cents"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "message_type": {
          "const": "forecast_request"
        },
        "adapter_contract": {
          "const": "1.0"
        },
        "dataset_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "origin": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "description": "Naive synthetic clock, not UTC metadata."
        },
        "history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HistoryRow"
          },
          "minItems": 1
        },
        "horizons_hours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "minItems": 1
        }
      },
      "required": [
        "message_type",
        "adapter_contract",
        "dataset_hash",
        "origin",
        "history",
        "horizons_hours"
      ],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "message_type": {
          "const": "forecast_response"
        },
        "adapter_contract": {
          "const": "1.0"
        },
        "origin": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
          "description": "Naive synthetic clock, not UTC metadata."
        },
        "training_cutoff": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$",
              "description": "Naive synthetic clock, not UTC metadata."
            },
            {
              "type": "null"
            }
          ]
        },
        "effective_family": {
          "type": "string",
          "enum": [
            "seasonal_baseline",
            "quantile_experiment",
            "sarimax_experiment",
            "pretrained_experiment",
            "unavailable"
          ]
        },
        "artifact_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{1,79}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "quality_label": {
          "type": "string",
          "enum": [
            "illustrative_fixture",
            "conventional_estimate",
            "experimental_estimate",
            "unavailable"
          ]
        },
        "predicted_gross": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Prediction"
          },
          "minItems": 0
        },
        "path_deficit_quantiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PathQuantile"
          },
          "minItems": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0
        }
      },
      "required": [
        "message_type",
        "adapter_contract",
        "origin",
        "training_cutoff",
        "effective_family",
        "artifact_id",
        "quality_label",
        "predicted_gross",
        "path_deficit_quantiles",
        "warnings"
      ],
      "additionalProperties": false
    }
  }
}
